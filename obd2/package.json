{
  "name": "painel-obd2",
  "version": "1.0.0",
  "description": "Painel OBD-II no navegador: lê o motor por um adaptador ELM327 Bluetooth BLE ou USB, sem servidor e sem internet",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "versao": "node ferramentas/versionar_casca.mjs --gravar",
    "ponte": "node ferramentas/ponte-wifi.mjs",
    "icones": "node ferramentas/gerar_icones.mjs",
    "servir": "python3 -m http.server 8000 --directory .."
  }
}
